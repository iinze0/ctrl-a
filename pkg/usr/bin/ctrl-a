#!/bin/sh
# Turn on Ctrl+A = select all in the terminals Kali already has.
set -eu

quiet=0
system=0
for arg in "$@"; do
    case "$arg" in
        --quiet) quiet=1 ;;
        --system) system=1 ;;
        -h|--help)
            echo "ctrl-a enables Ctrl+A select-all in the normal Kali terminal."
            echo "Close every terminal window, then open Terminal again."
            exit 0
            ;;
    esac
done

own() {
    file=$1
    user=$2
    if [ "$(id -u)" -eq 0 ] && [ -n "$user" ] && [ "$user" != UNKNOWN ]; then
        chown "$user:$user" "$file" 2>/dev/null || chown "$user" "$file" 2>/dev/null || true
    fi
}

apply_home() {
    home=$1
    user=$2
    [ -d "$home" ] || return 0

    dir="$home/.config/xfce4/terminal"
    mkdir -p "$dir"
    own "$dir" "$user"
    accels="$dir/accels.scm"
    line='(gtk_accel_path "<Actions>/terminal-window/select-all" "<Primary>a")'
    if [ -f "$accels" ]; then
        grep -v 'terminal-window/select-all' "$accels" > "$accels.ctrl-a" || true
        printf '%s\n' "$line" >> "$accels.ctrl-a"
        mv "$accels.ctrl-a" "$accels"
    else
        printf '%s\n' '; xfce4-terminal GtkAccelMap rc-file         -*- scheme -*-' ';' "$line" > "$accels"
    fi
    own "$accels" "$user"

    kdir="$home/.config"
    mkdir -p "$kdir"
    kons="$kdir/konsolerc"
    touch "$kons"
    if grep -q '^edit_select_all=' "$kons"; then
        grep -v '^edit_select_all=' "$kons" > "$kons.ctrl-a" || true
        mv "$kons.ctrl-a" "$kons"
    fi
    if grep -q '^\[Shortcuts\]' "$kons"; then
        awk 'BEGIN{done=0} {print} /^\[Shortcuts\]$/ && !done {print "edit_select_all=Ctrl+A"; done=1}' "$kons" > "$kons.ctrl-a"
        mv "$kons.ctrl-a" "$kons"
    else
        printf '\n[Shortcuts]\nedit_select_all=Ctrl+A\n' >> "$kons"
    fi
    own "$kons" "$user"

    if [ "$(id -u)" -ne 0 ] || [ "$user" = "$(id -un)" ]; then
        if command -v gsettings >/dev/null 2>&1; then
            if gsettings list-schemas 2>/dev/null | grep -qx 'org.gnome.Terminal.Legacy.Keybindings'; then
                gsettings set org.gnome.Terminal.Legacy.Keybindings select-all '<Control>a' || true
            fi
            if gsettings list-schemas 2>/dev/null | grep -qx 'org.mate.terminal.keybindings'; then
                gsettings set org.mate.terminal.keybindings select-all '<Control>a' || true
            fi
        fi
    fi
}

if [ "$system" -eq 1 ]; then
    for home in /root /home/*; do
        [ -d "$home" ] || continue
        user=$(stat -c '%U' "$home" 2>/dev/null || echo UNKNOWN)
        apply_home "$home" "$user"
    done
    exit 0
fi

user=$(id -un)
apply_home "${HOME:-/home/$user}" "$user"
if [ "$quiet" -eq 0 ]; then
    echo "Ctrl+A is set on the normal terminal."
    echo "Close every terminal window, then open Terminal again."
    echo "Ctrl+A selects the whole scrollback and copies it."
    echo "Home still jumps to the start of the line."
fi
